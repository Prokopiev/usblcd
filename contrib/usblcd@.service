# Keep one picture on the USB LCD panel, forever.
#
#   sudo systemctl enable --now 'usblcd@/srv/dash/dashboard.png'
#
# %i is the instance string — the image path.  systemd escapes the slashes for
# us, so the path arrives intact.
#
# The firmware paints its boot logo ~2-3 s after the last frame, so the only
# way to hold a picture is to keep re-sending it (`watch` does that at 150 ms).
# On Ctrl-C / `systemctl stop` the loop exits and the panel goes back to its
# logo, which is the behaviour you want from a service.

[Unit]
Description=usblcd: keep %i on the USB LCD panel
Documentation=file:///opt/usblcd/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/usblcd --brightness 70 watch %i
Restart=always
RestartSec=3
# A replug is covered by the Restart loop above (there is no valid unit key for
# "re-run me when this USB device appears"; UdevTrigger= is not a [Service] key).
# Run as the dedicated panel account created by contrib/sysusers.d/usblcd.conf:
# its primary group is the group the udev rule grants the device node to, so no
# root and no supplementary groups are needed.
User=usblcd
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
